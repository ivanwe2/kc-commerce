# Local development secrets. Copy to `.dev.vars` and fill in.
# `.dev.vars` is git-ignored and is the local stand-in for `wrangler secret put`.
#
# NOTE: there is no DATABASE_URL and no storage token on this stack.
# D1 and R2 are Worker bindings declared in wrangler.jsonc — nothing to configure.

# Required. Signs Payload auth tokens. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Local origin. Without this, NEXT_PUBLIC_SITE_URL falls back to the value in
# wrangler.jsonc (the workers.dev URL), so localhost is not a trusted origin and
# Payload's CSRF protection rejects cookie-authenticated writes from the admin
# with a 403 that looks like a permissions bug.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Extra origins to trust for CORS, CSRF and Server Actions — needed to
# browse from another device (a phone on the LAN or over a VPN). Comma-separated,
# including scheme and port. Without it the pages render but checkout and admin
# writes are rejected as cross-origin.
# ADDITIONAL_ORIGINS=http://192.168.0.29:3000,http://100.89.47.125:3000

# Optional until Phase 5 (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@kctrading.bg
ORDER_NOTIFICATION_EMAIL=

# Optional. Authorises Payload's job queue endpoint.
CRON_SECRET=

# trace | debug | info | warn | error | fatal
PAYLOAD_LOG_LEVEL=info

# Cloudflare Turnstile — bot protection on the public contact and withdrawal
# forms. Create a widget at Cloudflare dashboard -> Turnstile.
#
# Both halves are needed. With neither set the widget does not render and the
# server does not enforce, so the forms work unchanged — which is deliberate:
# the withdrawal form is legally required to function, and failing closed on a
# missing key would break it.
#
# Cloudflare publishes always-passing test keys for local development:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
